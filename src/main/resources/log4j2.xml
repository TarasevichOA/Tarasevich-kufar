<Configuration status="debug" strict="true"
               name="XMLConfigTest" packages="org.apache.logging.log4j.test">
    <Filter type="ThresholdFilter" level="trace"/>

    <Appenders>
        <!-- Ваша стандартная консоль -->
        <Console name="STDOUT">
            <Layout type="PatternLayout" pattern="%m %n"/>
        </Console>

        <!-- Роутинг: динамически создает файл под каждый тестовый класс -->
        <Routing name="SESSION_LOG_FILE">
            <Routes pattern="$${ctx:className}">
                <!-- Маршрут по умолчанию (если логи пишутся вне тестов) -->
                <Route key="$${ctx:className}">
                    <File name="DefaultFile" fileName="logs/app-before-tests.log">
                        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5level %logger{36} [%t] - %m%n"/>
                    </File>
                </Route>

                <!-- Динамический маршрут на основе имени класса -->
                <Route>
                    <File name="ClassFile-${ctx:className}"
                          fileName="logs/${ctx:className}-${date:yyyy-MM-dd_HH-mm-ss}.log">
                        <!-- Ваш оригинальный паттерн логирования -->
                        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss,SSS} %-5level %logger{36} [%t] - %m%n"/>
                    </File>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="STDOUT"/>
            <AppenderRef ref="SESSION_LOG_FILE"/>
        </Root>
    </Loggers>
</Configuration>
